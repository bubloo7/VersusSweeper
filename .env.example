# Copy to .env and fill in the values:  cp .env.example .env
# docker compose automatically reads the .env file in this directory.

############################
# Backend / Redis
############################
# In PROD, point these at your managed Redis (e.g. Redis Cloud).
# In DEV (make dev), these are overridden to use the bundled redis service.
REDIS_HOST=redis-14371.c92.us-east-1-3.ec2.cloud.redislabs.com
REDIS_PORT=14371
REDIS_USERNAME=default
REDIS_PASSWORD=

# Origin allowed to connect to the Socket.IO server (the frontend URL).
# DEV:  http://localhost:3000
# PROD: https://versussweeper.com
CORS_ORIGIN=http://localhost:3000

############################
# Frontend (Next.js)
############################
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time, NOT read at runtime. If you change these you MUST rebuild the frontend
# image (e.g. `docker compose build frontend` / `make build`), not just restart.
#
# This must be the PUBLIC ORIGIN the browser uses (the requests go through the
# nginx /api proxy), NOT the backend's internal host/port.
#   DEV:  http://localhost:3001  (talks to the backend container directly)
#   PROD: https://versussweeper.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Socket.IO path. Behind the production /api proxy this is "/api/socket.io";
# when talking to the backend directly (local dev) use "/socket.io".
NEXT_PUBLIC_SOCKET_PATH=/api/socket.io

############################
# Discord bot
############################
# Discord bot token (required to run the bot).
TOKEN=
# URL the bot uses to reach the backend. Inside compose, "backend" resolves
# to the backend service.
BACKEND_URL=http://backend:3001

############################
# Host port mappings (optional overrides)
############################
FRONTEND_PORT=3000
BACKEND_PORT=3001
REDIS_LOCAL_PORT=6379
